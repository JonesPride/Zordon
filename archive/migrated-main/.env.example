OPENAI_API_KEY=replace-with-your-openai-api-key
ZORDON_MODEL=gpt-5.6-terra
ZORDON_REQUEST_TIMEOUT_SECONDS=60
ZORDON_HISTORY_MESSAGE_LIMIT=40
ZORDON_OUTPUT_TOKEN_LIMIT=2048
ZORDON_REASONING_EFFORT=medium
# Optional metadata-only diagnostics. Prompt, response, secret, and traceback text is excluded.
# ZORDON_DEBUG_LOG=logs/zordon-debug.jsonl
